# Local NurAI development only. Never commit real values.

# Client/API connection. Use the explicit HTTP URL for a local API.
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_DOMAIN=localhost:5000

# Local PostgreSQL used by the server.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nurai
SESSION_SECRET=replace-with-a-random-development-secret-of-at-least-32-characters

# Optional cloud AI. Leave unset to use the local provider or disable AI.
# AI_INTEGRATIONS_OPENAI_API_KEY=replace-me
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
NURAI_AI_PROVIDER=local
NURAI_LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
NURAI_LOCAL_AI_API_KEY=ollama
NURAI_LOCAL_TEXT_MODEL=gemma3:4b
NURAI_ALLOW_LOCAL_RELIGIOUS_AI=false
NURAI_ALLOW_LOCAL_SENSITIVE_AI=false

# Optional provider values. Keep all secrets server-side unless a provider
# explicitly documents a public client key.
# GOOGLE_PLACES_API_KEY=replace-me
# REVENUECAT_SECRET_API_KEY=replace-me
# REVENUECAT_WEBHOOK_AUTHORIZATION=replace-me
# EXPO_PUBLIC_REVENUECAT_KEY=replace-me-public-sdk-key
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=replace-me-public-sdk-key

# Optional local admin/testing values. Do not enable production bypasses.
# NURAI_ADMIN_SECRET=replace-me
# NURAI_ADMIN_EMAILS=you@example.invalid
# NURAI_ALLOW_CLIENT_TIER_FOR_PAID_API=false
